            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "friends": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FriendReferenceDto"
            }
          }
        },
        "required": [
          "isPrivate",
          "isOwner",
          "id",
          "name",
          "picture"
        ]
      },
