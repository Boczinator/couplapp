  "info": {
    "title": "CouplApp API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "seb.boczek@gmail.com",
            "description": "The registered email address of the account"
          },
          "password": {
            "type": "string",
            "example": "SuperPassword$3213!",
            "description": "The plain-text authentication password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "User logged in successfully"
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "8c91c9d0-6dfd-4ffe-a07d-sdad12312"
          },
          "email": {
            "type": "string",
            "example": "john.doe@gmail.com"
          },
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "Doe"
          },
          "isVerified": {
            "type": "boolean",
            "example": true
          },
          "role": {
            "type": "string",
            "example": "user"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-08-06T06:52:20.204Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-08-06T06:52:20.204Z"
          },
          "activeProfileId": {
            "type": "string",
            "example": "8c91c9d0-6dfd-4fwee-a07d-sdad12312"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "isVerified",
          "role",
          "createdAt",
          "updatedAt",
          "activeProfileId"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ]
      },
      "LightProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "picture": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "picture"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "picture": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string"
          },
          "bannerPicture": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "isPrivate": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "picture",
          "isPrivate"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "picture": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "string"
          },
          "bannerPicture": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true
          },
          "isPrivate": {
            "type": "boolean",
            "nullable": true
          },
          "isOwner": {
            "type": "boolean"
          },
          "friendship": {
            "type": "object",
            "nullable": true
          },
          "friends": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "picture",
          "isPrivate",
          "isOwner"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {}
      },
      "FriendRequestDto": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "pending",
              "accepted",
              "blocked"
            ],
            "type": "string",
            "example": "pending"
          },
          "direction": {
            "type": "string",
            "example": "incoming",
            "description": "Direction of the request (e.g., incoming or outgoing)"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileDto"
          }
        },
        "required": [
          "status",
          "direction",
          "profile"
        ]
      },
      "InviteFriendDto": {
        "type": "object",
        "properties": {
          "receiverId": {
            "type": "string"
          }
        },
        "required": [
          "receiverId"
        ]
      },
      "CreateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "picture": {
            "type": "string",
            "nullable": true
          },
          "bannerPicture": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "isPrivate": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "name",
          "picture",
          "isPrivate"
        ]
      },
      "CreatePostDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "receiverId": {
            "type": "string"
          }
        },
        "required": [
          "text",
          "receiverId"
        ]
      },
      "UpdatePostDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "ConversationParticipantDto": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "example": "prof_8c91c9d0-6dfd-4ffe-a07d-b26d1024f883"
          },
          "conversationId": {
            "type": "string",
            "example": "conv_12345-6dfd-4ffe-a07d-b26d1024f883"
          },
          "joinedAt": {
            "format": "date-time",
            "type": "string",
            "nullable": true,
            "example": "2026-08-06T06:52:20.204Z"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileDto"
          }
        },
        "required": [
          "profileId",
          "conversationId",
          "joinedAt",
          "profile"
        ]
      },
      "ChatMessageDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "c91c9d0-6dfd-4ffe-a07d-b26d1024f883"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-08-06T06:52:20.204Z"
          },
          "senderId": {
            "type": "string",
            "example": "prof_8c91c9d0"
          },
          "conversationId": {
            "type": "string",
            "nullable": true,
            "example": "conv_12345"
          },
