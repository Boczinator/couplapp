            "type": "string"
          }
        },
        "required": [
          "receiverId"
        ]
      },
      "CreateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "picture": {
            "type": "string",
            "nullable": true
          },
          "bannerPicture": {
