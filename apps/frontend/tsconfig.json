{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"paths": { "@/*": ["./src/*"] },
		"types": ["vite/client"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"vite.config.ts",
		"src/vite-env.d.ts"
	],
	"exclude": ["node_modules", "dist"]
}
