doctype html
html
  head
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    style.
      body { font-family: Arial, sans-serif; background-color: #f4f4f4; padding: 20px; }
      .card { background: #ffffff; padding: 30px; border-radius: 8px; max-width: 500px; margin: 0 auto; }
      .button { display: inline-block; padding: 12px 24px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; }
  body
    div.card
      h2 Welcome, #{name}!
      p Thank you for registering. Please verify your email address to activate your account.
      p(style="text-align: center; margin: 30px 0;")
        a.button(href=verificationUrl) Verify Email
      p If you did not create an account, you can safely ignore this email.